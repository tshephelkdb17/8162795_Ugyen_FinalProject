<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_hero" android:padding="24dp">
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_discover" android:importantForAccessibility="no"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/brand" android:textSize="11sp" android:textColor="@color/mint" android:layout_marginTop="20dp" android:letterSpacing="0.12" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome" android:textSize="30sp" android:textColor="@color/white" android:layout_marginTop="12dp" android:fontFamily="sans-serif-medium"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_subtitle" android:textSize="15sp" android:textColor="@color/on_navy" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp" android:padding="22dp" android:background="@drawable/bg_panel">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_form_title" android:textSize="24sp" android:textColor="@color/ink" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_form_hint" android:textSize="14sp" android:textColor="@color/muted" android:layout_marginTop="6dp"/>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="@string/student_id" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/usernameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="number" android:imeOptions="actionNext" android:singleLine="true" android:autofillHints="username"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/first_name" app:endIconMode="password_toggle" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textPassword" android:saveEnabled="false" android:imeOptions="actionDone" android:singleLine="true" android:autofillHints="password"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="14dp" android:background="@drawable/bg_error" android:textColor="@color/error" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
            <ProgressBar android:id="@+id/progressBar" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:layout_marginTop="16dp" android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/loginButton" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp" android:text="@string/login" android:textSize="16sp" app:cornerRadius="14dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_hint" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="20dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:lineSpacingExtra="3dp"/>
    </LinearLayout>
</ScrollView>
